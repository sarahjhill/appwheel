# Copy this file to .env and fill in real values.
# .env is private and is never committed to GitHub.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Sign in with Google (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reading screenshots with AI (from console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# ----- On Heroku only (set these in Settings > Config Vars, not in .env) -----
# DATABASE_URL=        (your PostgreSQL database address)
# SITE_URL=            (for example https://appwheel-xxxx.herokuapp.com)
# EMAIL_HOST=          (your email service, for example smtp-relay.brevo.com)
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=AppWheel <hello@yourdomain.com>
